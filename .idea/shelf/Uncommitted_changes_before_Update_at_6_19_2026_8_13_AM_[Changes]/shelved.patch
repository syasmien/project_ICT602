-  lat: 3.0738
-  lng: 101.5183
-  phone: "03-55108888"
-  operating_hours: "10:00 AM - 10:00 PM"
-  is_24hours: false
-
-Document 2:
-  name: "Watsons Pharmacy"
-  address: "Plaza Masalam, Shah Alam"
-  lat: 3.0800
-  lng: 101.5340
-  phone: "03-55123456"
-  operating_hours: "10:00 AM - 10:00 PM"
-  is_24hours: false
-
-Document 3:
-  name: "Farmasi Al-Ikhlas"
-  address: "Seksyen 7, Shah Alam"
